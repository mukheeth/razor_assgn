# Copy this file to .env and fill in your WooCommerce credentials.
# Never commit .env to version control.

WC_STORE_URL=https://example.com
WC_CONSUMER_KEY=your_consumer_key
WC_CONSUMER_SECRET=your_consumer_secret

# Optional tuning
# MAX_PER_PAGE=100
# DEFAULT_PER_PAGE=20
# CONNECT_TIMEOUT=5.0
# READ_TIMEOUT=30.0
# MAX_RETRIES=3
# RETRY_BACKOFF_BASE=1.0
